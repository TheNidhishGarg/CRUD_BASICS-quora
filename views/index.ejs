<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Quora Posts</h1>
    <% for(post of posts){ %>
    <div id="post">
        <h3 id="user">@<%= post.username %></h3>
        <p id="content"><%= post.content %></p>
        <a href="/posts/<%=post.id%>"><button>See Details</button></a>
        <a href="/posts/<%=post.id%>/edit"><button>Edit Post</button></a>
        <br>
        <br>
        <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
            <button>Delete</button>
        </form>
        
    </div>
    <% } %>
    <br>
    <br>
    <a href="/posts/new"><button>Add new Post</button></a>
</body>
</html>